---
permalink: /.htaccess
eleventyExcludeFromCollections: true
---
{#-
  Generates _site/.htaccess. The canonical origin comes from "url" in src/_data/site.json,
  so switching between www and non-www is a one-line change there.
-#}
{%- set origin = site.url -%}
{%- set host = origin | replace("https://", "") -%}
{%- set otherHost = host.slice(4) if host.startsWith("www.") else "www." + host -%}
{#- Where @11ty/eleventy-img writes content-hashed files. Must match its urlPath. -#}
{%- set hashedImagePath = "/assets/img/generated/" -%}
# Apache config for OzHosting (Plesk). GENERATED from src/htaccess.njk – edit that, not this.
#
# Canonical origin: {{ origin }} (from site.json). {{ otherHost }} and http:// redirect here.
# `npm run check` verifies every redirect target below exists in the build.

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset utf-8
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# ---------------------------------------------------------------------------
# 1. Block dotfiles and folders (.git, .env, …) but allow /.well-known/ (SSL checks).
# ---------------------------------------------------------------------------
RewriteRule (^|/)\.(?!well-known/) - [F,L]

# ---------------------------------------------------------------------------
# 2. Old server files that must never be served again (see project brief §10).
#    Answer "410 Gone" even if a copy is left behind on the server.
# ---------------------------------------------------------------------------
RewriteRule ^(php_mail_test\.php|500\.php|functions\.php|acttreecom\.zip|readme\.txt)$ - [G,L]
RewriteRule ^(mail|contact_form|archived|scripts)(/|$) - [G,L]

# ---------------------------------------------------------------------------
# 3. Old site URLs -> new URLs. Absolute targets so http/www requests
#    reach the final URL in a single redirect. NE keeps "#" unescaped.
# ---------------------------------------------------------------------------
# /index.html, /default.html and /any/path/index.html -> /any/path/
# Matches THE_REQUEST (what the browser actually asked for), not the rewritten path:
# DirectoryIndex serves "/" as index.html via an internal redirect, and a plain
# ^index\.html$ rule would 301 that internal request back to "/" in an endless loop.
RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)(?:index|default)\.html[\s?] [NC]
RewriteRule ^ {{ origin }}/%1 [R=301,L]

RewriteRule ^about\.html$                    {{ origin }}/why-act-tree-felling/ [R=301,L]
RewriteRule ^testimonials\.html$             {{ origin }}/why-act-tree-felling/#reviews [R=301,NE,L]
RewriteRule ^services\.html$                 {{ origin }}/services/ [R=301,L]
RewriteRule ^tree-removal\.html$             {{ origin }}/services/tree-removal/ [R=301,L]
RewriteRule ^tree-pruning\.html$             {{ origin }}/services/tree-pruning/ [R=301,L]
RewriteRule ^stump-grinding\.html$           {{ origin }}/services/stump-grinding/ [R=301,L]
RewriteRule ^powerline-clearance\.html$      {{ origin }}/services/powerline-clearance/ [R=301,L]
RewriteRule ^cable-and-bracing\.html$        {{ origin }}/services/cabling-and-bracing/ [R=301,L]
RewriteRule ^commercial-works\.html$         {{ origin }}/services/commercial-tree-services/ [R=301,L]
RewriteRule ^tree-consultation\.html$        {{ origin }}/services/arborist-consultation/ [R=301,L]
RewriteRule ^tree-consul-health\.html$       {{ origin }}/services/arborist-consultation/#health-and-condition [R=301,NE,L]
RewriteRule ^tree-consul-risk\.html$         {{ origin }}/services/arborist-consultation/#tree-risk-assessment [R=301,NE,L]
RewriteRule ^tree-consul-management\.html$   {{ origin }}/services/arborist-consultation/#tree-management-plans [R=301,NE,L]
RewriteRule ^tree-consul-root\.html$         {{ origin }}/services/arborist-consultation/#tree-root-damage [R=301,NE,L]
RewriteRule ^tree-consul-disease\.html$      {{ origin }}/services/arborist-consultation/#disease-identification [R=301,NE,L]
RewriteRule ^tree-consul-elm-leaf\.html$     {{ origin }}/services/arborist-consultation/#elm-leaf-beetle [R=301,NE,L]
RewriteRule ^faq\.html$                      {{ origin }}/resources/faq/ [R=301,L]
RewriteRule ^careers\.html$                  {{ origin }}/careers/ [R=301,L]
RewriteRule ^contact\.html$                  {{ origin }}/contact/ [R=301,L]
RewriteRule ^survey\.html$                   {{ origin }}/ [R=301,L]
RewriteRule ^sitemap\.html$                  {{ origin }}/sitemap.xml [R=301,L]

# TBC with client: is mulch still offered? Temporary (302) until decided, so
# browsers don't cache it. Change to 301 once the final target is agreed.
RewriteRule ^mulch-orders\.html$             {{ origin }}/contact/ [R=302,L]

# ---------------------------------------------------------------------------
# 4. Force HTTPS and the canonical host ({{ otherHost }} -> {{ host }}) in one hop.
# ---------------------------------------------------------------------------
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^{{ otherHost | replace(".", "\\.") | safe }}$ [NC]
RewriteRule ^ {{ origin }}%{REQUEST_URI} [R=301,L]
</IfModule>

# ---------------------------------------------------------------------------
# Security headers
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
# Enable HSTS once HTTPS on both {{ host }} and {{ otherHost }} is confirmed working after launch:
# Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# ---------------------------------------------------------------------------
# Types and compression
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
AddType image/avif .avif
AddType image/webp .webp
AddType text/javascript .js .mjs
AddType image/svg+xml .svg
AddType font/woff2 .woff2
</IfModule>

<IfModule mod_deflate.c>
<IfModule mod_filter.c>
AddOutputFilterByType DEFLATE text/html text/css text/javascript text/plain text/xml application/xml image/svg+xml
</IfModule>
</IfModule>

# ---------------------------------------------------------------------------
# Caching
#   HTML, sitemap, robots   no-cache: always revalidate, so deploys show immediately.
#   Other static files      1 week, NOT immutable: logo, icons, badges, favicon,
#                           fonts, and any CSS/JS requested without ?v=.
#   Versioned CSS/JS        1 year, immutable: URLs carry ?v=<build id>, which
#                           changes on every build.
#   Hashed images           1 year, immutable: only {{ hashedImagePath }}, where the
#                           image pipeline names files by content hash.
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
ExpiresActive On
ExpiresDefault "access plus 1 hour"
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType application/xml "access plus 0 seconds"
ExpiresByType text/xml "access plus 0 seconds"
ExpiresByType text/plain "access plus 0 seconds"
ExpiresByType text/css "access plus 1 week"
ExpiresByType text/javascript "access plus 1 week"
ExpiresByType application/javascript "access plus 1 week"
ExpiresByType image/avif "access plus 1 week"
ExpiresByType image/webp "access plus 1 week"
ExpiresByType image/jpeg "access plus 1 week"
ExpiresByType image/png "access plus 1 week"
ExpiresByType image/gif "access plus 1 week"
ExpiresByType image/svg+xml "access plus 1 week"
ExpiresByType image/x-icon "access plus 1 week"
ExpiresByType image/vnd.microsoft.icon "access plus 1 week"
ExpiresByType font/woff2 "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
<FilesMatch "\.(html|xml|txt)$">
Header set Cache-Control "no-cache"
</FilesMatch>
<FilesMatch "\.(css|m?js|avif|webp|jpe?g|png|gif|svg|ico|woff2)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>

# <If> sections merge after <FilesMatch>, so these override the 1-week default.
<If "%{REQUEST_URI} =~ m#\.(css|m?js)$# && %{QUERY_STRING} =~ /(^|&)v=/">
Header set Cache-Control "public, max-age=31536000, immutable"
Header unset Expires
</If>
<If "%{REQUEST_URI} =~ m#^{{ hashedImagePath }}#">
Header set Cache-Control "public, max-age=31536000, immutable"
Header unset Expires
</If>
</IfModule>
