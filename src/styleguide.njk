---
layout: layouts/base.njk
title: Component styleguide
description: Preview of every component, fed from _data. Development builds only.
noindex: true
eleventyExcludeFromCollections: true
---
{%- from "components/hero.njk" import hero, heroFeature -%}
{%- from "components/button.njk" import button -%}
{%- from "components/service-card.njk" import serviceCard -%}
{%- from "components/preview-card.njk" import previewCard -%}
{%- from "components/split.njk" import split -%}
{%- from "components/section-heading.njk" import sectionHeading -%}
{%- from "components/content-blocks.njk" import contentBlocks -%}
{%- from "components/phone-link.njk" import phoneLink -%}

{#- Feature hero (homepage). Holds this page's only <h1>. -#}
{{ heroFeature("Component styleguide", text="Every component, fed from _data. Built in development only, never in production.", primary=site.cta.freeQuote, phone=site.phones | phoneById(site.cta.call.phone), callLabel=site.cta.call.label) }}

{#- Split hero (inner pages), shown with an <h2> so the page keeps one <h1>. #}
{{ hero("Split hero (inner pages)", text="Used by page.njk and service.njk until inner pages are designed.", eyebrow="Hero", primary=site.cta.quote, phone=site.phones | primary, level=2) }}

<section class="page-container space-y-6 py-section-sm" aria-labelledby="sg-buttons">
  {{ sectionHeading("sg-buttons", "Buttons and links", eyebrow="Section heading with eyebrow") }}
  <div class="flex flex-wrap gap-3">
    {{ button("Primary", url="#") }}
    {{ button("Secondary", url="#", variant="secondary") }}
    {{ button("Button Element", type="button") }}
  </div>
  <div class="flex flex-wrap gap-3 rounded-card bg-dark p-6">
    {{ button("Inverse", url="#", variant="inverse") }}
  </div>
  <ul class="space-y-2">
    {%- for phone in site.phones %}
    <li>{{ phoneLink(phone, showLabel=true, class="hover:underline") }}</li>
    {%- endfor %}
  </ul>
</section>

<section class="bg-card py-section-sm" aria-labelledby="sg-cards">
  <div class="page-container">
    {{ sectionHeading("sg-cards", "Service cards", eyebrow="service-card") }}
    <ul class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {%- for service in services %}
      <li>{{ serviceCard(service) }}</li>
      {%- endfor %}
    </ul>
  </div>
</section>

{{ split("sg-split-light", "Split section, light", body=["Figma “Call to Action”, first instance: cream text panel with a full-height photo. On mobile the text comes first, then the image.", "No button in this instance."], eyebrow="split") }}

{{ split("sg-split-dark", "Split section, dark", body=["Figma “Call to Action”, second instance: the quote band (components/cta.njk) uses this with site.cta.band."], eyebrow="split", tone="dark", primary=site.cta.quote) }}

<section class="py-section-sm" aria-labelledby="sg-preview">
  <div class="page-container">
    {{ sectionHeading("sg-preview", "Preview cards", eyebrow="preview-card") }}
    <ul class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {%- for card in [
        { "heading": "Qualified people", "text": "Card with an image, an H3 and text." },
        { "heading": "Specialist equipment", "text": "Four across on desktop, one on mobile." },
        { "heading": "Professional standards", "text": "Content comes from the page's front matter." },
        { "heading": "Thorough clean-up", "text": "Used in the homepage's Why section." }
      ] %}
      <li>{{ previewCard(card) }}</li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="bg-card" aria-label="Trust icons">
  {% include "components/trust-icons.njk" %}
</section>

{% include "components/reviews.njk" %}

<section class="page-container space-y-2 pt-section-sm" aria-labelledby="sg-logos">
  <h2 id="sg-logos" class="font-display text-3xl">Logo marquee states</h2>
  <p>1. Animating (default): hover or focus pauses it; the round button toggles pause. 2. Paused (button pressed). 3. Static grid, shown when the visitor prefers reduced motion.</p>
</section>

{%- set logosHeadingId = "sg-logos-animating" %}
{%- set logosHeading = "1. Animating" %}
{%- set logosState = null %}
{% include "components/logo-grid.njk" %}

{%- set logosHeadingId = "sg-logos-paused" %}
{%- set logosHeading = "2. Paused" %}
{%- set logosState = "paused" %}
{% include "components/logo-grid.njk" %}

{%- set logosHeadingId = "sg-logos-static" %}
{%- set logosHeading = "3. Static (reduced motion)" %}
{%- set logosState = "static" %}
{% include "components/logo-grid.njk" %}
{%- set logosHeadingId = null %}{% set logosHeading = null %}{% set logosState = null %}

{% include "components/cta.njk" %}

<section class="page-container py-section-sm" aria-labelledby="sg-content">
  {{ sectionHeading("sg-content", "Content blocks (" + services[1].title + ")", eyebrow="content-blocks") }}
  <div class="mt-8 max-w-prose space-y-10">
    {%- for section in services[1].sections %}
    <div>
      {%- if section.heading %}<h3 class="mb-4 font-display text-2xl">{{ section.heading }}</h3>{% endif %}
      {{ contentBlocks(section.content) }}
    </div>
    {%- endfor %}
  </div>
</section>

<section id="quote" class="bg-card py-section-sm" aria-labelledby="sg-form">
  <div class="page-container">
    <div class="max-w-prose">
      {{ sectionHeading("sg-form", "Quote form", eyebrow="jotform-quote") }}
      <div class="mt-8">{% include "components/jotform-quote.njk" %}</div>
    </div>
  </div>
</section>
