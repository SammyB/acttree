{#- Section order follows docs/figma-homepage.md. Header, hero and footer come from the layouts. -#}
{%- from "components/section-heading.njk" import sectionHeading -%}
{%- from "components/service-card.njk" import serviceCard -%}
{%- from "components/split.njk" import split -%}
{%- from "components/preview-card.njk" import previewCard -%}
{%- from "components/button.njk" import button -%}

{#- 3. Services grid #}
<section class="bg-canvas section-y" aria-labelledby="services-heading">
  <div class="page-container">
    {{ sectionHeading("services-heading", home.services.heading, eyebrow=home.services.eyebrow) }}
    <ul class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {%- for service in services | selectattr("showOnHome") %}
      <li>{{ serviceCard(service) }}</li>
      {%- endfor %}
    </ul>
  </div>
</section>

{#- 4. Experience split #}
{{ split("experience-heading", home.experience.heading, body=home.experience.body, image=home.experience.image) }}

{#- 5. Trust icons #}
{% include "components/trust-icons.njk" %}

{#- 6. Reviews (Google reviews only on the homepage) #}
{%- set reviewItems = reviews | whereEq("source", "google") %}
{%- set reviewsEyebrow = home.reviews.eyebrow %}
{%- set reviewsHeading = home.reviews.heading %}
{% include "components/reviews.njk" %}

{#- 7. Quote CTA band #}
{% include "components/cta.njk" %}

{#- 8. Why ACT Tree Felling #}
<section class="bg-canvas section-y" aria-labelledby="why-heading">
  <div class="page-container">
    {{ sectionHeading("why-heading", home.why.heading, eyebrow=home.why.eyebrow) }}
    <div class="mt-4 max-w-measure space-y-3 text-lg">
      {%- for paragraph in home.why.intro %}
      <p>{{ paragraph }}</p>
      {%- endfor %}
    </div>
    <ul class="mt-8 grid gap-x-8 gap-y-8 md:grid-cols-2 lg:grid-cols-4">
      {%- for card in home.why.cards %}
      <li>{{ previewCard(card) }}</li>
      {%- endfor %}
    </ul>
    <div class="mt-8">{{ button(home.why.button.label, url=home.why.button.url, class="w-full md:w-auto") }}</div>
  </div>
</section>

{#- 9. Client logos #}
{%- set logosEyebrow = home.logos.eyebrow %}
{%- set logosHeading = home.logos.heading %}
{%- set logosBody = home.logos.body %}
{% include "components/logo-grid.njk" %}
