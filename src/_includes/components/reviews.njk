{#-
  Reviews (Figma "Google review"): three equal columns on desktop – the Google summary card, then a
  scroll-snap carousel showing two review cards – with round prev/next buttons under the cards.
  /assets/js/carousel.js shows the buttons when there's more to scroll.
  Optional, set before including:
    reviewItems     which reviews to show (default: all of reviews.json)
    reviewsEyebrow / reviewsHeading
  [FIX] Site font and green button (Figma mock-up uses Inter and black), no clipping, and never
  relative dates ("1 week ago").
-#}
{%- from "components/section-heading.njk" import sectionHeading -%}
{%- from "components/button.njk" import button -%}
{%- set items = reviewItems or reviews -%}
{%- set summary = site.googleReviews -%}
{%- macro stars(rating, size="size-5") -%}
<span class="flex gap-1 text-star" aria-hidden="true">
  {%- for i in range(0, 5) %}{% icon "star", size, "filled" %}{% endfor -%}
</span>
<span class="sr-only">Rated {{ rating }} out of 5</span>
{%- endmacro -%}
<section id="reviews" class="bg-canvas section-y" aria-labelledby="reviews-heading" data-carousel>
  <div class="page-container">
    {{ sectionHeading("reviews-heading", reviewsHeading or "See what our customers say", eyebrow=reviewsEyebrow or "Reviews") }}

    <div class="mt-12 grid gap-8 lg:grid-cols-3">
      {%- if summary.count %}
      <div class="flex min-h-105 flex-col items-center justify-center gap-3 rounded-card border-2 border-page bg-card p-6 text-center">
        <img src="/assets/img/brand/google.svg" alt="Google" width="64" height="20" eleventy:ignore>
        <p class="font-display text-2xl font-semibold text-ink">{{ site.name }}</p>
        <p class="flex items-center gap-2"><span class="text-xl font-semibold text-ink">{{ summary.rating }}</span>{{ stars(summary.rating) }}</p>
        {%- if summary.profileUrl %}
        <a href="{{ summary.profileUrl }}" class="text-sm underline" rel="noopener">Read our {{ summary.count }} Reviews</a>
        {%- else %}
        <p class="text-sm">Read our {{ summary.count }} Reviews</p>
        {%- endif %}
        {%- if summary.writeReviewUrl %}
        <div class="mt-2 w-full">{{ button("Write a Review", url=summary.writeReviewUrl, attrs='rel="noopener"') }}</div>
        {%- endif %}
      </div>
      {%- endif %}

      <ul class="relative flex min-w-0 snap-x snap-mandatory gap-8 overflow-x-auto {{ 'lg:col-span-2' if summary.count else 'lg:col-span-3' }}" tabindex="0" aria-label="Customer reviews (scrollable)" data-carousel-track>
        {%- for review in items %}
        <li class="shrink-0 basis-full snap-start md:basis-half-gap-8">
          <article class="flex h-full min-h-105 flex-col gap-5 rounded-card border-2 border-page bg-card p-6 " aria-label="Review by {{ review.name }}">
            <div class="flex items-center gap-2">
              <span class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-primary text-xl text-on-primary" aria-hidden="true">{{ review.name | first | upper }}</span>
              <div>
                <p class="font-semibold text-ink">{{ review.name }}</p>
                {%- if review.role %}<p class="text-sm">{{ review.role }}</p>{% endif %}
              </div>
            </div>
            {%- if review.rating %}
            <div class="flex">{{ stars(review.rating) }}</div>
            {%- endif %}
            <blockquote class="flex-1">
              <p>{{ review.text or review.excerpt }}</p>
            </blockquote>
            {%- if review.ownerResponse %}
            <div class="rounded-xl bg-page px-4 py-3 text-sm">
              <p class="text-xs font-medium text-ink">Response from the owner</p>
              <p class="mt-2">{{ review.ownerResponse }}</p>
            </div>
            {%- endif %}
            {%- if review.url %}
            <a href="{{ review.url }}" class="inline-flex items-center gap-2 border-t border-line pt-3 text-sm hover:underline" rel="noopener">{% icon "brand-google", "size-5" %}View on Google<span class="sr-only"> (review by {{ review.name }})</span></a>
            {%- endif %}
          </article>
        </li>
        {%- endfor %}
      </ul>
    </div>

    <div class="mt-8 flex justify-end gap-3" data-carousel-controls hidden>
      <button type="button" class="flex size-12 items-center justify-center rounded-full bg-placeholder text-ink hover:bg-stone disabled:opacity-60" data-carousel-prev>
        <span class="sr-only">Previous reviews</span>{% icon "chevron-left", "size-7" %}
      </button>
      <button type="button" class="flex size-12 items-center justify-center rounded-full bg-primary text-on-primary hover:bg-primary-hover disabled:opacity-60" data-carousel-next>
        <span class="sr-only">Next reviews</span>{% icon "chevron-right", "size-7" %}
      </button>
    </div>
  </div>
</section>
<script type="module" src="/assets/js/carousel.js?v={{ env.buildId }}"></script>
