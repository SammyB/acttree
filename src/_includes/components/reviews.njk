{#-
  Reviews carousel from reviews.json. Scroll-snap list; /assets/js/carousel.js adds prev/next buttons.
  Optional: {% set reviewsHeading = "..." %} before including.
-#}
<section id="reviews" class="py-section" aria-labelledby="reviews-heading" data-carousel>
  <div class="page-container">
    <div class="flex items-end justify-between gap-4">
      <h2 id="reviews-heading" class="font-display text-3xl font-bold">{{ reviewsHeading or "What our customers say" }}</h2>
      <div class="flex gap-2" data-carousel-controls hidden>
        <button type="button" class="rounded-full border-2 border-ink p-2 hover:bg-ink hover:text-page disabled:opacity-40" data-carousel-prev>
          <span class="sr-only">Previous reviews</span>{% icon "chevron-left", "size-5" %}
        </button>
        <button type="button" class="rounded-full border-2 border-ink p-2 hover:bg-ink hover:text-page disabled:opacity-40" data-carousel-next>
          <span class="sr-only">Next reviews</span>{% icon "chevron-right", "size-5" %}
        </button>
      </div>
    </div>
    <ul class="mt-8 flex snap-x snap-mandatory gap-6 overflow-x-auto pb-4" tabindex="0" aria-label="Customer reviews (scrollable)" data-carousel-track>
      {%- for review in reviews %}
      <li class="shrink-0 basis-full snap-start md:basis-1/2 lg:basis-1/3">
        <figure class="flex h-full flex-col rounded-card border border-line bg-card p-6">
          {% icon "quote", "size-8 text-ink-muted" %}
          <blockquote class="mt-4 flex-1">
            <p>&ldquo;{{ review.excerpt }}&rdquo;</p>
          </blockquote>
          <figcaption class="mt-6 text-sm">
            <span class="block font-semibold">{{ review.name }}</span>
            <span class="block text-ink-muted">{{ review.role }}</span>
          </figcaption>
        </figure>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
<script type="module" src="/assets/js/carousel.js"></script>
