{#-
  Reviews (Figma "Google review"): Google summary card + scroll-snap carousel of review cards.
  /assets/js/carousel.js adds the prev/next buttons.
  Optional, set before including:
    reviewItems     which reviews to show (default: all of reviews.json)
    reviewsEyebrow / reviewsHeading
  No relative dates ("1 week ago") are ever shown.
-#}
{%- from "components/section-heading.njk" import sectionHeading -%}
{%- set items = reviewItems or reviews -%}
{%- set summary = site.googleReviews -%}
{%- macro stars(rating, size="size-5") -%}
<span class="flex text-star" aria-hidden="true">
  {%- for i in range(0, 5) %}{% icon "star", size, "filled" %}{% endfor -%}
</span>
<span class="sr-only">Rated {{ rating }} out of 5</span>
{%- endmacro -%}
<section id="reviews" class="py-section" aria-labelledby="reviews-heading" data-carousel>
  <div class="page-container">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      {{ sectionHeading("reviews-heading", reviewsHeading or "See what our customers say", eyebrow=reviewsEyebrow or "Reviews") }}
      <div class="flex gap-3" data-carousel-controls hidden>
        <button type="button" class="rounded-full border-2 border-ink p-3 hover:bg-ink hover:text-page disabled:opacity-40" data-carousel-prev>
          <span class="sr-only">Previous reviews</span>{% icon "chevron-left", "size-5" %}
        </button>
        <button type="button" class="rounded-full border-2 border-primary bg-primary p-3 text-on-primary hover:bg-primary-hover disabled:opacity-40" data-carousel-next>
          <span class="sr-only">Next reviews</span>{% icon "chevron-right", "size-5" %}
        </button>
      </div>
    </div>

    <div class="mt-8 grid gap-6 lg:grid-cols-4">
      {%- if summary.count %}
      <div class="flex flex-col items-start gap-3 rounded-card border border-line bg-card p-6">
        {% icon "brand-google", "size-8" %}
        <p class="font-semibold">{{ site.name }}</p>
        <p class="flex items-center gap-2"><span class="font-display text-3xl font-bold">{{ summary.rating }}</span>{{ stars(summary.rating) }}</p>
        {%- if summary.profileUrl %}
        <a href="{{ summary.profileUrl }}" class="text-primary underline" rel="noopener">Read our {{ summary.count }} Reviews</a>
        {%- else %}
        <p class="text-ink-muted">Read our {{ summary.count }} Reviews</p>
        {%- endif %}
        {%- if summary.writeReviewUrl %}
        <a href="{{ summary.writeReviewUrl }}" class="mt-auto inline-flex items-center justify-center rounded-button bg-primary px-5 py-3 font-semibold text-on-primary hover:bg-primary-hover" rel="noopener">Write a Review</a>
        {%- endif %}
      </div>
      {%- endif %}

      <ul class="relative flex min-w-0 snap-x snap-mandatory gap-6 overflow-x-auto pb-4 {{ 'lg:col-span-3' if summary.count else 'lg:col-span-4' }}" tabindex="0" aria-label="Customer reviews (scrollable)" data-carousel-track>
        {%- for review in items %}
        <li class="shrink-0 basis-full snap-start md:basis-1/2">
          <article class="flex h-full flex-col gap-4 rounded-card border border-line bg-card p-6" aria-label="Review by {{ review.name }}">
            <div class="flex items-center gap-3">
              <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-primary font-semibold text-on-primary" aria-hidden="true">{{ review.name | first | upper }}</span>
              <div>
                <p class="font-semibold">{{ review.name }}</p>
                {%- if review.role %}<p class="text-sm text-ink-muted">{{ review.role }}</p>{% endif %}
              </div>
            </div>
            {%- if review.rating %}
            <div class="flex">{{ stars(review.rating) }}</div>
            {%- endif %}
            <blockquote class="flex-1">
              <p>{{ review.text or review.excerpt }}</p>
            </blockquote>
            {%- if review.ownerResponse %}
            <div class="rounded-button bg-page p-4 text-sm">
              <p class="font-semibold">Response from the owner</p>
              <p class="mt-1">{{ review.ownerResponse }}</p>
            </div>
            {%- endif %}
            {%- if review.url %}
            <a href="{{ review.url }}" class="inline-flex items-center gap-1 text-sm font-semibold text-primary hover:underline" rel="noopener">View on Google<span class="sr-only"> (review by {{ review.name }})</span>{% icon "external-link", "size-4" %}</a>
            {%- endif %}
          </article>
        </li>
        {%- endfor %}
      </ul>
    </div>
  </div>
</section>
<script type="module" src="/assets/js/carousel.js?v={{ env.buildId }}"></script>
