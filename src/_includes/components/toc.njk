{#-
  "On this page" table of contents for service pages. sections: service.sections items that have an id.
    variant "card":    desktop sidebar card (lg and up), with scroll-spy.
    variant "details": mobile/tablet <details> under the hero (below lg), closed by default.
  /assets/js/toc.js highlights the section in view (aria-current="true") and closes the <details>
  when a link is tapped. Without JS both are plain anchor links.
-#}
{%- macro toc(sections, variant="card") -%}
{%- set list -%}
<ul class="space-y-1">
  {%- for section in sections %}
  <li><a href="#{{ section.id }}" class="toc-link" data-toc-link>{{ section.heading }}</a></li>
  {%- endfor %}
</ul>
{%- endset -%}
{%- if variant == "details" -%}
<details class="group rounded-card border border-line bg-page lg:hidden" data-toc-details>
  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-4 font-semibold text-ink">
    On this page
    {% icon "chevron-down", "size-5 transition-transform group-open:rotate-180" %}
  </summary>
  <nav aria-label="Page sections" class="px-2 pb-4">{{ list | trim | safe }}</nav>
</details>
{%- else -%}
<nav aria-labelledby="on-this-page" class="rounded-card border border-line bg-page p-6">
  <h2 id="on-this-page" class="mb-3 text-base font-semibold">On this page</h2>
  {{ list | trim | safe }}
</nav>
{%- endif %}
<script type="module" src="/assets/js/toc.js?v={{ env.buildId }}"></script>
{%- endmacro -%}
