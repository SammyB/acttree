{#-
  Site footer (Figma "Footer"): nav row, four contact columns, copyright, social icons and
  the Arboriculture Australia member badge. Everything comes from site.json and nav.json.
  Social accounts with an empty URL are hidden.
-#}
{%- from "components/phone-link.njk" import phoneLink -%}
<footer class="bg-dark text-on-dark">
  <div class="page-container py-section-sm">
    <div class="flex flex-col gap-6 border-b border-ink-muted pb-8 lg:flex-row lg:items-center lg:justify-between">
      <p class="font-display text-xl font-bold">{{ site.name }}</p>
      <nav aria-label="Footer">
        <ul class="flex flex-wrap gap-x-6 gap-y-2">
          {%- for link in nav.footer %}
          <li><a href="{{ link.url }}" class="font-semibold hover:underline"{% if page.url == link.url %} aria-current="page"{% endif %}>{{ link.label }}</a></li>
          {%- endfor %}
        </ul>
      </nav>
    </div>

    <div class="grid gap-8 py-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <h2 class="font-semibold">Get in touch</h2>
        <ul class="mt-3 space-y-2">
          {%- for phone in site.phones %}
          <li>{{ phoneLink(phone, class="hover:underline", showLabel=true, showIcon=false) }}</li>
          {%- endfor %}
          <li><a href="mailto:{{ site.email }}" class="hover:underline">Email: {{ site.email }}</a></li>
        </ul>
      </div>
      <div>
        <h2 class="font-semibold">Office hours</h2>
        <p class="mt-3">{{ site.hours.display }}</p>
      </div>
      <div>
        <h2 class="font-semibold">Street address</h2>
        <address class="mt-3 not-italic">{{ site.address.street }}<br>{{ site.address.locality }} {{ site.address.region }} {{ site.address.postcode }}</address>
      </div>
      <div>
        <h2 class="font-semibold">Postal address</h2>
        <address class="mt-3 not-italic">{{ site.postalAddress.street }}<br>{{ site.postalAddress.locality }} {{ site.postalAddress.region }} {{ site.postalAddress.postcode }}</address>
      </div>
    </div>

    <div class="flex flex-col gap-6 border-t border-ink-muted pt-8 md:flex-row md:items-center md:justify-between">
      <p class="text-sm">
        &copy; {% year %} {{ site.legalName }}
        {%- for link in nav.legal %} &middot; <a href="{{ link.url }}" class="hover:underline">{{ link.label }}</a>{% endfor %}
      </p>
      <div class="flex items-center gap-4">
        {%- for account in site.social | selectattr("url") %}
        <a href="{{ account.url }}" class="rounded-button p-1 hover:bg-on-dark hover:text-dark" rel="noopener">
          {% icon "brand-" + (account.name | lower) %}<span class="sr-only">{{ site.name }} on {{ account.name }}</span>
        </a>
        {%- endfor %}
        {#- Arboriculture Australia "Member" badge placeholder until the artwork is supplied. #}
        {%- for membership in site.memberships %}
        <span class="rounded-button bg-placeholder-strong px-3 py-2 text-xs font-semibold text-dark">{{ membership }} Member</span>
        {%- endfor %}
      </div>
    </div>
  </div>
</footer>
