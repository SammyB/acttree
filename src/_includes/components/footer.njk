{#-
  Site footer (Figma "Footer"): centred, on grey 900 with 96px padding. Underlined nav row, divider,
  four contact columns (only the numbers and email are links), divider, copyright and privacy link,
  social icons, then the Arboriculture Australia "Member" badge.
  Everything comes from site.json and nav.json. Social accounts with an empty URL are hidden.
-#}
<footer class="bg-dark text-on-dark">
  <div class="page-container flex flex-col items-center gap-12 section-y">
    <nav aria-label="Footer">
      <ul class="flex flex-wrap justify-center gap-x-8 gap-y-3">
        {%- for link in nav.footer %}
        <li><a href="{{ link.url }}" class="underline hover:text-sand"{% if page.url == link.url %} aria-current="page"{% endif %}>{{ link.label }}</a></li>
        {%- endfor %}
      </ul>
    </nav>

    <hr class="w-full border-sand">

    <div class="grid w-full gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <h2 class="mb-3 text-base font-bold text-on-dark">Get in touch</h2>
        <ul class="space-y-3">
          {%- for phone in site.phones %}
          <li>{{ phone.label }} <a href="tel:{{ phone.tel }}" data-track="phone" class="underline hover:text-sand">{{ phone.display | nbsp }}</a></li>
          {%- endfor %}
          <li>Email <a href="mailto:{{ site.email }}" class="underline hover:text-sand">{{ site.email }}</a></li>
        </ul>
      </div>
      <div>
        <h2 class="mb-3 text-base font-bold text-on-dark">Office hours</h2>
        <p>{{ site.hours.time }}<br>{{ site.hours.dayRange }}</p>
      </div>
      <div>
        <h2 class="mb-3 text-base font-bold text-on-dark">Street address</h2>
        <address class="not-italic">{{ site.address.street }}<br>{{ site.address.locality }} {{ site.address.region }} {{ site.address.postcode }}</address>
      </div>
      <div>
        <h2 class="mb-3 text-base font-bold text-on-dark">Postal address</h2>
        <address class="not-italic">{{ site.postalAddress.street }}<br>{{ site.postalAddress.locality }} {{ site.postalAddress.region }} {{ site.postalAddress.postcode }}</address>
      </div>
    </div>

    <hr class="w-full border-sand">

    <div class="flex flex-col items-center gap-6 text-center">
      <p>&copy; {% year %} {{ site.legalName }}</p>
      {%- for link in nav.legal %}
      <a href="{{ link.url }}" class="underline hover:text-sand">{{ link.label }}</a>
      {%- endfor %}
    </div>

    <div class="flex flex-col items-center gap-12">
      <div class="flex items-center gap-6">
        {%- for account in site.social | selectattr("url") %}
        <a href="{{ account.url }}" class="rounded-button hover:text-sand" rel="noopener">
          {% icon "brand-" + (account.name | lower), "size-6", "filled" %}<span class="sr-only">{{ site.name }} on {{ account.name }}</span>
        </a>
        {%- endfor %}
      </div>
      {#- Arboriculture Australia "Member" badge, 134px. #}
      <img src="{{ site.memberBadge.src }}" alt="{{ site.memberBadge.alt }}" sizes="134px" eleventy:widths="134,268" eleventy:formats="avif,webp,png" class="size-33.5">
    </div>
  </div>
</footer>
