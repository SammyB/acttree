{#- Site footer: contact details, service links, footer nav groups, social, membership, legal. -#}
{%- from "components/phone-link.njk" import phoneLink -%}
<footer class="bg-dark text-on-dark">
  <div class="page-container grid gap-10 py-section-sm md:grid-cols-2 lg:grid-cols-4">
    <div class="space-y-4">
      <p class="font-display text-xl font-bold">{{ site.name }}</p>
      <ul class="space-y-2">
        {%- for phone in site.phones %}
        <li>{{ phoneLink(phone, class="hover:underline", showLabel=true) }}</li>
        {%- endfor %}
        <li>
          <a href="mailto:{{ site.email }}" class="inline-flex items-center gap-2 hover:underline">{% icon "mail", "size-5 shrink-0" %}<span>{{ site.email }}</span></a>
        </li>
      </ul>
      <address class="flex gap-2 not-italic">
        {% icon "map-pin", "size-5 shrink-0" %}
        <span>{{ site.address.street }}<br>{{ site.address.locality }} {{ site.address.region }} {{ site.address.postcode }}</span>
      </address>
      <p class="flex gap-2">{% icon "clock", "size-5 shrink-0" %}<span>{{ site.hours.display }}</span></p>
    </div>

    <nav aria-label="Services footer">
      <h2 class="font-semibold">Services</h2>
      <ul class="mt-4 space-y-2">
        {%- for service in services %}
        <li><a href="/services/{{ service.slug }}/" class="hover:underline">{{ service.title }}</a></li>
        {%- endfor %}
      </ul>
    </nav>

    {%- for group in nav.footer %}
    <nav aria-label="{{ group.heading }} footer">
      <h2 class="font-semibold">{{ group.heading }}</h2>
      <ul class="mt-4 space-y-2">
        {%- for link in group.links %}
        <li><a href="{{ link.url }}" class="hover:underline">{{ link.label }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
    {%- endfor %}
  </div>

  <div class="page-container flex flex-col gap-6 border-t border-ink-muted py-6 md:flex-row md:items-center md:justify-between">
    <div class="flex items-center gap-4">
      {%- for account in site.social %}
      <a href="{{ account.url }}" class="rounded-button p-1 hover:bg-on-dark hover:text-dark" rel="noopener">
        {% icon "brand-" + (account.name | lower) %}<span class="sr-only">{{ site.name }} on {{ account.name }}</span>
      </a>
      {%- endfor %}
      {%- for membership in site.memberships %}
      <span class="rounded-button bg-placeholder-strong px-3 py-2 text-xs font-semibold text-dark">Member of {{ membership }}</span>
      {%- endfor %}
    </div>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
      <p>&copy; {% year %} {{ site.name }}</p>
      <ul class="flex gap-4">
        {%- for link in nav.legal %}
        <li><a href="{{ link.url }}" class="hover:underline">{{ link.label }}</a></li>
        {%- endfor %}
      </ul>
    </div>
  </div>
</footer>
