{#-
  Client logos (Figma "LogoGrid"): sand background, text on the left, logo grid on the right.
  Static grid; only animate if the designer specifies it (and then respect prefers-reduced-motion).
  Optional, set before including: logosHeading, logosBody (array of paragraphs).
-#}
{%- from "components/section-heading.njk" import sectionHeading -%}
<section class="bg-sand py-section" aria-labelledby="logos-heading">
  <div class="page-container grid items-center gap-10 lg:grid-cols-2">
    <div class="max-w-measure space-y-4">
      {{ sectionHeading("logos-heading", logosHeading or "Trusted throughout Canberra") }}
      {%- for paragraph in logosBody %}
      <p>{{ paragraph }}</p>
      {%- endfor %}
    </div>
    <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3">
      {%- for logo in logos %}
      <li class="flex aspect-video items-center justify-center rounded-card bg-card p-4 text-center text-sm font-semibold text-ink-muted">
        {%- if logo.image %}
        <img src="{{ logo.image }}" alt="{{ logo.name }}" class="max-h-full w-auto" loading="lazy">
        {%- else %}
        {{ logo.name }}
        {%- endif %}
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
