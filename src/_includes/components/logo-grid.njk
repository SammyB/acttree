{#-
  Client logos (Figma "LogoGrid"): sand background with the text first.
    Mobile:  two rows of 168px white tiles, the second row shifted right, running off both edges.
    Desktop: two columns of 300px tiles beside the text, the right column dropped 48px, running off
             the top and bottom of the section.
  One list serves both layouts (screen readers hear each logo once).
  Only logos with "show": true in logos.json are displayed; blank tiles pad the grid to 6 (as in Figma).
  Static; only animate if the designer specifies it (and then respect prefers-reduced-motion).
  Optional, set before including: logosHeading, logosBody (array of paragraphs).
-#}
{%- from "components/section-heading.njk" import sectionHeading -%}
{%- set shown = logos | selectattr("show") -%}
{%- set tiles = 6 if shown.length < 6 else shown.length -%}
<section class="overflow-hidden bg-sand" aria-labelledby="logos-heading">
  <div class="page-container grid gap-12 section-y lg:min-h-206 lg:grid-cols-2 lg:items-center lg:py-0">
    <div class="max-w-narrow space-y-4">
      {{ sectionHeading("logos-heading", logosHeading or "Trusted throughout Canberra") }}
      <div class="space-y-3 text-lg">
        {%- for paragraph in logosBody %}
        <p>{{ paragraph }}</p>
        {%- endfor %}
      </div>
    </div>
    <div class="relative lg:h-full">
      <ul class="-ml-12 grid w-max grid-flow-col grid-rows-2 gap-4 lg:absolute lg:top-1/2 lg:right-0 lg:ml-0 lg:grid-rows-3 lg:gap-8 lg:-translate-y-1/2">
        {%- for i in range(0, tiles) %}
        {%- set logo = shown[i] %}
        {#- Mobile: odd tiles form the second row, shifted right. Desktop: tiles 4–6 form the dropped column. #}
        <li class="flex size-42 items-center justify-center rounded-lg bg-card p-5 lg:rounded-card text-center font-semibold lg:size-75 lg:p-6{{ ' translate-x-24 lg:translate-x-0' if i % 2 == 1 }}{{ ' lg:translate-y-12' if i >= 3 }}"{% if not logo %} aria-hidden="true"{% endif %}>
          {%- if logo and logo.image %}
          <img src="{{ logo.image }}" alt="{{ logo.name }}" sizes="(min-width: 1024px) 252px, 128px" eleventy:widths="128,252,504" eleventy:formats="avif,webp,png" class="max-h-28 w-auto object-contain">
          {%- elif logo %}
          {{ logo.name }}
          {%- endif %}
        </li>
        {%- endfor %}
      </ul>
    </div>
  </div>
</section>
