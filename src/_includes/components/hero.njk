{#-
  Page heroes. Each holds the page's only <h1>.
    hero()        split layout for inner pages (not designed yet)
    heroFeature() homepage: full-bleed photo, dark gradient on the left, left-aligned text (Figma "Hero")
  primary: { label, url } for the main button
  phone:   an item from site.phones for the call button (optional)
  callLabel: text for the call button (defaults to the number)
-#}
{%- from "components/button.njk" import button -%}
{%- from "components/phone-link.njk" import phoneLink -%}

{#- level: heading level; only the styleguide uses 2, to show this hero below the feature hero. #}
{%- macro hero(heading, text=null, eyebrow=null, primary=null, phone=null, level=1) -%}
{%- set titleId = "page-title" if level == 1 else "hero-title-" + level -%}
<section class="bg-dark text-on-dark" aria-labelledby="{{ titleId }}">
  <div class="page-container grid items-center gap-10 py-section-sm lg:grid-cols-2 lg:py-section">
    <div>
      {%- if eyebrow %}
      <p class="mb-4 text-base uppercase text-on-dark">{{ eyebrow }}</p>
      {%- endif %}
      <h{{ level }} id="{{ titleId }}" class="font-display text-5xl leading-none text-balance text-on-dark lg:text-7xl">{{ heading }}</h{{ level }}>
      {%- if text %}
      <p class="mt-6 text-xl text-sand">{{ text }}</p>
      {%- endif %}
      {%- if primary or phone %}
      <div class="mt-8 flex flex-wrap gap-3">
        {%- if primary %}{{ button(primary.label, url=primary.url) }}{% endif %}
        {%- if phone %}{{ phoneLink(phone, class="rounded-button border-2 border-on-dark px-5 py-3 font-semibold hover:bg-on-dark hover:text-dark") }}{% endif %}
      </div>
      {%- endif %}
    </div>
    <div class="aspect-photo rounded-card bg-placeholder-strong" aria-hidden="true"></div>
  </div>
</section>
{%- endmacro -%}

{%- macro heroFeature(heading, text=null, primary=null, phone=null, callLabel=null, image=null) -%}
<section class="relative isolate overflow-hidden bg-dark text-on-dark" aria-labelledby="page-title">
  {#- Photo: fairy-wren, 1467 × 762 desktop (a separate mobile crop is still to come from the designer).
      Above the fold, so it loads eagerly with high priority. #}
  <div class="absolute inset-0 -z-20 bg-placeholder-strong">
    {%- if image %}
    <img src="{{ image.src }}" alt="{{ image.alt }}" sizes="100vw" eleventy:widths="768,1440,2172" loading="eager" fetchpriority="high" class="size-full object-cover">
    {%- endif %}
  </div>
  {#- Figma overlay: black 55% up to 65% across, fading to clear at the right edge. #}
  <div class="absolute inset-0 -z-10 bg-black/55 md:bg-transparent md:bg-linear-to-r md:from-black/55 md:from-65% md:to-transparent" aria-hidden="true"></div>
  <div class="page-container flex min-h-164 items-center py-12 lg:min-h-190 lg:py-section">
    <div class="max-w-hero space-y-6">
      <h1 id="page-title" class="font-display text-5xl leading-none text-balance text-on-dark lg:text-7xl">{{ heading }}</h1>
      {%- if text %}
      <p class="text-xl text-sand">{{ text }}</p>
      {%- endif %}
      {%- if primary or phone %}
      <div class="flex flex-col gap-4 sm:flex-row">
        {%- if primary %}{{ button(primary.label, url=primary.url, size="lg") }}{% endif %}
        {%- if phone %}{{ phoneLink(phone, label=callLabel, showIcon=false, trailingIcon="circle-chevron-right", trailingIconClass="size-6", class="justify-center rounded-button border-2 border-primary bg-page px-6 py-4 text-lg leading-7 text-primary hover:bg-canvas") }}{% endif %}
      </div>
      {%- endif %}
    </div>
  </div>
</section>
{%- endmacro -%}
