{#- FAQ accordion using native <details>, so it works without JS. items: faq.json entries. -#}
{%- from "components/content-blocks.njk" import contentBlocks -%}
{%- macro faqList(items) -%}
<div class="divide-y divide-line rounded-card border border-line bg-card">
  {%- for item in items %}
  <details id="{{ item.id }}" class="group scroll-mt-8 p-6">
    <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-semibold">
      <span>{{ item.question }}</span>
      <span class="shrink-0 transition-transform group-open:rotate-180">{% icon "chevron-down", "size-5" %}</span>
    </summary>
    <div class="mt-4">{{ contentBlocks(item.answer) }}</div>
  </details>
  {%- endfor %}
</div>
{%- endmacro -%}
