{#- Trust icons from site.trust: icon above an H3-size label. 3 columns on desktop, 1 on mobile. -#}
<div class="page-container py-section-sm">
  <ul class="grid gap-10 text-center sm:grid-cols-2 lg:grid-cols-3">
    {%- for item in site.trust %}
    <li class="flex flex-col items-center gap-3">
      {% icon item.icon, "size-10 text-primary" %}
      <p class="font-display text-xl font-semibold">{{ item.label }}</p>
    </li>
    {%- endfor %}
  </ul>
</div>
