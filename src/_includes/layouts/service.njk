---
layout: layouts/base.njk
---
{#-
  Service page. Everything comes from the `service` item in services.json (see services/services.njk).
  Section ids (services.json) are the single source for the "On this page" links and for the old-URL
  redirects in htaccess.njk; npm run check confirms every redirect #anchor exists here.

  Below lg:  hero, "On this page" <details>, content, quote card, other services.
  lg and up: content (2/3) + sidebar (1/3). The TOC card and quote card stick together while the
             content scrolls (stopping before "Other services"); "Other services" doesn't stick.
             No ancestor may have overflow: hidden, or sticky stops working.
-#}
{%- from "components/hero.njk" import hero -%}
{%- from "components/button.njk" import button -%}
{%- from "components/phone-link.njk" import phoneLink -%}
{%- from "components/content-blocks.njk" import contentBlocks -%}
{%- from "components/toc.njk" import toc -%}
{%- set anchoredSections = service.sections | selectattr("id") | selectattr("heading") -%}
{%- set hasToc = anchoredSections.length > 1 -%}

{{ hero(service.title, text=service.intro, eyebrow="Services", primary=site.cta.quote, phone=site.phones | primary) }}

{%- if hasToc %}
<div class="page-container pt-8 lg:hidden">
  {{ toc(anchoredSections, variant="details") }}
</div>
{%- endif %}

<div class="page-container grid gap-12 py-section-sm lg:grid-cols-3">
  <div class="max-w-prose space-y-10 lg:col-span-2">
    {%- for section in service.sections %}
    {%- if section.heading %}
    <section{% if section.id %} id="{{ section.id }}"{% endif %} aria-labelledby="{{ section.id or ('section-' + loop.index) }}-heading" class="scroll-mt-anchor">
      <h2 id="{{ section.id or ('section-' + loop.index) }}-heading" class="mb-4 font-display text-2xl">{{ section.heading }}</h2>
      {{ contentBlocks(section.content) }}
    </section>
    {%- else %}
    <div{% if section.id %} id="{{ section.id }}" class="scroll-mt-anchor"{% endif %}>
      {{ contentBlocks(section.content) }}
    </div>
    {%- endif %}
    {%- endfor %}
    {{- content | safe }}
  </div>

  <aside class="flex flex-col gap-8" aria-label="Quote and other services">
    {#- Sticky track: fills the sidebar down to "Other services", so the sticky group stops there. #}
    <div class="lg:flex-1">
      <div class="space-y-8 lg:sticky-sidebar">
        {%- if hasToc %}
        <div class="hidden lg:block">{{ toc(anchoredSections, variant="card") }}</div>
        {%- endif %}

        <div class="rounded-card bg-dark p-6 text-on-dark">
          <h2 class="font-display text-2xl text-on-dark">{{ site.cta.band.heading }}</h2>
          <p class="mt-2 text-sand">{{ site.cta.band.body[0] }}</p>
          <div class="mt-4 flex flex-col gap-3">
            {{ button(site.cta.quote.label, url=site.cta.quote.url) }}
            {{ phoneLink(site.phones | primary, class="justify-center rounded-button border-2 border-on-dark px-5 py-3 hover:bg-on-dark hover:text-dark") }}
          </div>
        </div>
      </div>
    </div>

    <nav aria-labelledby="other-services" class="rounded-card border border-line bg-page p-6">
      <h2 id="other-services" class="text-base font-semibold">Other services</h2>
      <ul class="mt-3 space-y-2">
        {%- for other in services %}
        {%- if other.slug != service.slug %}
        <li><a href="/services/{{ other.slug }}/" class="text-primary hover:underline">{{ other.title }}</a></li>
        {%- endif %}
        {%- endfor %}
      </ul>
    </nav>
  </aside>
</div>

{% include "components/reviews.njk" %}
