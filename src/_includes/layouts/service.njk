---
layout: layouts/base.njk
---
{#- Service page. Everything comes from the `service` item in services.json (see services/services.njk). -#}
{%- from "components/hero.njk" import hero -%}
{%- from "components/button.njk" import button -%}
{%- from "components/phone-link.njk" import phoneLink -%}
{%- from "components/content-blocks.njk" import contentBlocks -%}
{%- set anchoredSections = service.sections | selectattr("id") -%}

{{ hero(service.title, text=service.intro, eyebrow="Services", primary=site.cta.quote, phone=site.phones | primary) }}

<div class="page-container grid gap-12 py-section-sm lg:grid-cols-3">
  <div class="max-w-prose space-y-10 lg:col-span-2">
    {%- for section in service.sections %}
    {%- if section.heading %}
    <section{% if section.id %} id="{{ section.id }}"{% endif %} aria-labelledby="{{ section.id or ('section-' + loop.index) }}-heading" class="scroll-mt-8">
      <h2 id="{{ section.id or ('section-' + loop.index) }}-heading" class="mb-4 font-display text-2xl">{{ section.heading }}</h2>
      {{ contentBlocks(section.content) }}
    </section>
    {%- else %}
    <div{% if section.id %} id="{{ section.id }}"{% endif %}>
      {{ contentBlocks(section.content) }}
    </div>
    {%- endif %}
    {%- endfor %}
    {{- content | safe }}
  </div>

  <aside class="space-y-8" aria-label="Quote and other services">
    {%- if anchoredSections.length > 1 %}
    <nav aria-labelledby="on-this-page" class="rounded-card border border-line bg-card p-6">
      <h2 id="on-this-page" class="font-semibold">On this page</h2>
      <ul class="mt-3 space-y-2">
        {%- for section in anchoredSections %}
        <li><a href="#{{ section.id }}" class="text-primary hover:underline">{{ section.heading }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
    {%- endif %}

    <div class="rounded-card bg-dark p-6 text-on-dark">
      <h2 class="font-display text-2xl text-on-dark">{{ site.cta.band.heading }}</h2>
      <p class="mt-2 text-sand">{{ site.cta.band.body[0] }}</p>
      <div class="mt-4 flex flex-col gap-3">
        {{ button(site.cta.quote.label, url=site.cta.quote.url) }}
        {{ phoneLink(site.phones | primary, class="justify-center rounded-button border-2 border-on-dark px-5 py-3 font-semibold hover:bg-on-dark hover:text-dark") }}
      </div>
    </div>

    <nav aria-labelledby="other-services" class="rounded-card border border-line bg-card p-6">
      <h2 id="other-services" class="font-semibold">Other services</h2>
      <ul class="mt-3 space-y-2">
        {%- for other in services %}
        {%- if other.slug != service.slug %}
        <li><a href="/services/{{ other.slug }}/" class="text-primary hover:underline">{{ other.title }}</a></li>
        {%- endif %}
        {%- endfor %}
      </ul>
    </nav>
  </aside>
</div>

{% include "components/reviews.njk" %}
